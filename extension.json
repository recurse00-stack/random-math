{
  "id": "mixing-entropy.random-math",
  "name": "抽选与数学增强",
  "description": "候选池管理、概率抽取、玩家选择、随机数与公式计算。支持变量公式、取整精度、余数与范围限制。",
  "icon": "assets/cover.png",
  "author": "混合熵",
  "version": "3.0.0",
  "entry": "dist/index.js",
  "sdkVersion": ">=1.21.0",
  "dataDependencies": {
    "pickTable": {
      "name": "随机候选表",
      "description": "weight 填 10% 锁定10%概率，数字或表达式按权重分配剩余概率；全部留空均匀。固定概率超额、剩余无正权重默认报错。",
      "contract": "mixing-entropy.random-math.pick-table",
      "version": "^1.0.0",
      "access": "read",
      "autoCreate": {
        "name": "随机候选表",
        "contractVersion": "1.0.0",
        "runtimePolicy": "readonly",
        "schema": {
          "type": "object",
          "required": [
            "label"
          ],
          "columns": [
            {
              "key": "pool",
              "label": "池名（分组；可空=默认池）",
              "type": "text",
              "description": "一张表 = 多个安科池：同池名的行归为一组，方法按池名筛选；留空的行属于默认池"
            },
            {
              "key": "label",
              "label": "内容",
              "type": "text"
            },
            {
              "key": "weight",
              "label": "权重／固定概率",
              "type": "text",
              "description": "10%=锁定10%概率；10=相对权重；var(\"变量名\")=动态权重。固定概率先保留，数字和表达式分配剩余概率；如 A=10%、B=20、C=30，概率为10%、36%、54%。% 后缀只接受数字，不用于表达式。"
            }
          ]
        }
      }
    },
    "funcLib": {
      "name": "函数规则表",
      "description": "自定义计算函数：名称 + 白名单表达式（可用 x/y/z/w 占位）",
      "contract": "mixing-entropy.random-math.func-lib",
      "version": "^1.0.0",
      "access": "read",
      "autoCreate": {
        "name": "函数规则表",
        "contractVersion": "1.0.0",
        "runtimePolicy": "readonly",
        "schema": {
          "type": "object",
          "required": [
            "name",
            "expr"
          ],
          "columns": [
            {
              "key": "name",
              "label": "函数名",
              "type": "text"
            },
            {
              "key": "expr",
              "label": "表达式",
              "type": "long-text",
              "description": "白名单语法：数字、参数 x/y/z/w、运算符 + - * / ^、括号；函数 sqrt() pow() floor() round() min() max() clamp()；示例与速查见扩展设置「表达式语法速查」"
            },
            {
              "key": "desc",
              "label": "说明",
              "type": "text"
            }
          ]
        }
      }
    }
  }
}
